# service/.env.example
#
# Env var schema for the roadmodel FastAPI service. Names only;
# no values. Copy to service/.env for local development. For
# staging/production, set these in Railway env vars.

# AI provider keys — consumed by the recommend_structured provider
# chain inside the roadmodel package.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Shared secret between the Vercel Next.js routes and this service.
# Incoming /v1/recommend calls must send Authorization: Bearer <token>.
ROADMODEL_INTERNAL_TOKEN=
