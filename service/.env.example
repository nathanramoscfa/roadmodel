# service/.env.example
#
# Env var schema for the roadmodel FastAPI service. Names only;
# no values. Copy to service/.env for local development (uvicorn
# app.main:app). For deployed environments, set these in the
# roadmodel-api Vercel project env vars.

# AI provider keys — consumed by the recommend_structured provider
# chain inside the roadmodel package.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Supabase project URL + service-role key — consumed by the Step 6
# rate limiter and the Phase 4 audit log. Service-role bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
