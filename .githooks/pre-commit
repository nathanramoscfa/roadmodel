#!/usr/bin/env bash
# .githooks/pre-commit
# Reject commits on protected branches. Roadmodel uses GitHub branch
# protection with enforce_admins: true on main, so a direct push would
# be rejected at the server anyway — but commits made locally on main
# silently strand work and break the phase-roadmap six-stage lifecycle
# (Stage 1: `git checkout -b feature/phaseNN-stepNN-<slug>` BEFORE any
# edit). This hook catches the mistake at commit time, before the work
# becomes hard to recover.
#
# Install (one-time per clone):
#   git config core.hooksPath .githooks
#
# It also runs the secret scan (Phase 4.11 Step 6): `gitleaks git --staged`
# over what is about to be committed, the same detector phase-verify.yml's
# post job runs over history. A machine without gitleaks gets a notice, not a
# block; CI is the backstop.
#
# Bypass (NOT recommended; reserved for emergency; skips the branch guard
# only, never the secret scan):
#   ROADMODEL_ALLOW_MAIN_COMMIT=1 git commit ...

set -euo pipefail

protected_branches=(main master)

current_branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "DETACHED")"

for protected in "${protected_branches[@]}"; do
  if [[ "${ROADMODEL_ALLOW_MAIN_COMMIT:-0}" != "1" && "$current_branch" == "$protected" ]]; then
    cat >&2 <<EOF
================================================================
  REFUSED: cannot commit directly to '$current_branch'.
================================================================

  Roadmodel's branch protection rejects direct pushes to
  '$current_branch' (enforce_admins: true). The phase-roadmap
  six-stage lifecycle requires Stage 1 (branch checkout) BEFORE
  any commit lands.

  Recover:
    1. Save current changes:
         git stash push -u -m "wip"
    2. Switch to a feature branch (use the step's **Branch:**
       line from the phase roadmap, or invent one):
         git checkout -b feature/phaseNN-stepNN-<slug>
    3. Restore changes and commit:
         git stash pop
         git add ... && git commit ...

  Emergency bypass (use only if you know why):
    ROADMODEL_ALLOW_MAIN_COMMIT=1 git commit ...

EOF
    exit 1
  fi
done

# Secret scan over the staged diff. --redact keeps a finding's value out of
# the terminal and the scrollback.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact >&2; then
    echo "pre-commit: gitleaks found a secret in the staged changes; commit refused." >&2
    exit 1
  fi
else
  echo "pre-commit: gitleaks not installed; skipping the secret scan (CI still runs it)." >&2
fi

exit 0
