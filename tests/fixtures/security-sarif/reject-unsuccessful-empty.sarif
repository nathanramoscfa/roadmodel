{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.25.6"
        },
        "extensions": [
          {
            "name": "codeql/python-queries",
            "semanticVersion": "synthetic-fixture-1",
            "guid": "00000000-0000-4000-8000-000000000001",
            "rules": [
              {
                "id": "py/synthetic-high",
                "guid": "00000000-0000-4000-8000-000000000011",
                "properties": {
                  "security-severity": "7.5",
                  "tags": [
                    "security"
                  ]
                },
                "defaultConfiguration": {
                  "level": "warning"
                }
              },
              {
                "id": "py/synthetic-medium",
                "guid": "00000000-0000-4000-8000-000000000012",
                "properties": {
                  "security-severity": "6.1",
                  "tags": [
                    "security"
                  ]
                },
                "defaultConfiguration": {
                  "level": "warning"
                }
              }
            ]
          }
        ]
      },
      "invocations": [
        {
          "executionSuccessful": false
        }
      ],
      "artifacts": [
        {
          "location": {
            "uri": "scripts/check_codeql_sarif.py",
            "uriBaseId": "%SRCROOT%"
          }
        }
      ],
      "results": []
    }
  ]
}
