# Placeholder environment for BUILD + E2E. Committed on purpose: every value
# here is a fake, and the tests need the app to boot, not to reach anything.
#
# It exists because these values used to live in two places a developer never
# gets automatically — the `env:` blocks in .github/workflows/tests.yml and the
# `webServer.env` in playwright.config.ts. A plain local `npm run build` got
# neither and died with an opaque message:
#
#     Error: Failed to collect page data for /api/roadmap
#
# which is env.ts's `.min(1)` validation failing, not a code fault. CI stayed
# green the whole time, so the suite passed there and failed here (issue #655).
#
# CI, playwright.config.ts and `npm run build:ci` / `npm run test:ci` all read
# THIS file now. Add a variable once, here.
#
# Never put a real secret in this file. Real values come from
# scripts/with-prod-secrets.sh (macOS keychain) or `vercel env pull`.
NEXT_PUBLIC_SITE_URL=https://staging.roadmodel.ai
SUPABASE_URL=https://ci-placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ci-placeholder-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=ci-placeholder-anon-key
UPSTASH_REDIS_URL=https://ci-placeholder.upstash.io
UPSTASH_REDIS_TOKEN=ci-placeholder-redis-token
ROADMODEL_IP_SALT=ci-placeholder-ip-salt
# env.ts validates GOOGLE_API_KEY via .min(1), so the app cannot boot without
# one. The roadmap spec mocks /api/roadmap at the Playwright route layer; no
# real Gemini call is ever made.
GOOGLE_API_KEY=ci-placeholder-google-api-key
