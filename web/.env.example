# web/.env.example
#
# Copy to web/.env.local for local development. Names mirror web/lib/env.ts.
# Value sources and consumers: infra/README.md "Environment variables".

# Public site URL for metadata and absolute links (Next.js web tier).
NEXT_PUBLIC_SITE_URL=https://staging.roadmodel.ai

# Railway FastAPI recommender base URL (Step 5 API route calls via lib/api.ts).
ROADMODEL_SERVICE_URL=

# Shared secret sent to FastAPI on internal recommend calls (Step 5).
ROADMODEL_INTERNAL_TOKEN=

# Supabase project URL for the audit log (Step 6).
SUPABASE_URL=

# Supabase service-role key for server-side audit writes (Step 6).
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis URL for rate limiting (Step 6).
UPSTASH_REDIS_URL=

# Upstash Redis token for rate limiting (Step 6).
UPSTASH_REDIS_TOKEN=
