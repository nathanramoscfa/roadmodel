<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent: once an hour, refresh usage meters and apply fresh pool states
  to docs/user-context.md; dated expired rows still clear and roll forward.
  The local file is gitignored; normalized observations sync using a
  per-user Keychain session.

  Install (one time):
    cp scripts/com.roadmodel.roll-pool-status.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.roadmodel.roll-pool-status.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.roadmodel.roll-pool-status.plist
    rm ~/Library/LaunchAgents/com.roadmodel.roll-pool-status.plist

  Adjust the path below if your checkout is not at ~/roadmodel.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roadmodel.roll-pool-status</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec /opt/homebrew/bin/python3.12 -I -X utf8 "$HOME/roadmodel/scripts/private_job.py" pools</string>
  </array>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
