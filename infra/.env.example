# infra/.env.example
#
# Env var schema for the roadmodel managed-service stack. Names only;
# no values. Copy to .env at the repo root (gitignored) for local
# development; for staging/production, populate Vercel and Railway
# env vars in their respective dashboards. The "Value source" and
# "Consumed by" columns in infra/README.md "Environment variables"
# define which vendor dashboard each var lives in.

# AI provider keys — consumed by the FastAPI service (Step 3).
# Pay-as-you-go on each provider; usage is capped per the
# "Provider cost ceilings" table in infra/README.md. Never expose
# these to the Vercel web tier — the browser must not see them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Shared secret between the Vercel Next.js routes and the Railway
# FastAPI service. Step 5 sends this on every internal call; the
# FastAPI middleware (Step 3) rejects calls without it. Rotate on
# any Vercel ↔ Railway connectivity incident.
ROADMODEL_INTERNAL_TOKEN=

# Supabase project URL — same value in both the Vercel and Railway
# tiers. Read from the Supabase dashboard → Settings → API.
SUPABASE_URL=

# Supabase service-role key — bypasses RLS. Lives ONLY in Railway
# env vars and the Supabase dashboard itself; NEVER copy this into
# Vercel env vars or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis connection — consumed by the FastAPI rate limiter
# (Step 6). Documented now so Step 6 doesn't relitigate the Redis
# vendor decision. URL and token come from the Upstash console.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
