# infra/.env.example
#
# Env var schema for the roadmodel managed-service stack. Names only;
# no values. Copy to .env at the repo root (gitignored) for local
# development; for staging/production, populate Vercel env vars in
# each project's dashboard. The "Value source" and "Consumed by"
# columns in infra/README.md "Environment variables" define which
# vendor dashboard each var lives in.

# AI provider keys — consumed by the FastAPI service on the
# roadmodel-api Vercel project. Pay-as-you-go on each provider; usage
# is capped per the "Provider cost ceilings" table in infra/README.md.
# Never expose these to the Vercel web tier — the browser must not
# see them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Supabase project URL — set on both roadmodel-web and roadmodel-api.
# Read from the Supabase dashboard → Settings → API.
SUPABASE_URL=

# Supabase service-role key — bypasses RLS. Lives ONLY on
# roadmodel-api Vercel env vars and the Supabase dashboard itself;
# NEVER copy this into the browser-exposed web tier or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis connection — consumed by the Phase 3 Step 6 rate
# limiter on both the roadmodel-web (Next.js IP rate limit) and
# roadmodel-api (FastAPI same-origin rate limit) tiers. Documented now
# so Step 6 doesn't relitigate the Redis vendor decision. URL and
# token come from the Upstash console.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
